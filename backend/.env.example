PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shopkart
JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=development

# Razorpay TEST MODE keys (never use Live keys for this project).
# Leave blank to run without payments; checkout then shows "Payment gateway is not configured".
# Format: RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx   RAZORPAY_KEY_SECRET=<your test key secret>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
